{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptimizeResult",
  "type": "object",
  "required": ["track_id", "accuracy_level", "sequence", "bom", "shopping"],
  "properties": {
    "track_id": {"type": "string"},
    "accuracy_level": {"type": "string"},
    "strategy": {"type": "string"},
    "sequence": {"type": "array", "items": {"type": "string"}},
    "bom": {"type": "object"},
    "metrics": {"type": "object"},
    "profile": {"type": "object"},
    "shopping": {
      "type": "object",
      "required": ["missing", "owned_used", "within_shop_budget"],
      "properties": {
        "used": {"type": "object"},
        "owned_used": {"type": "object"},
        "leftover": {"type": "object"},
        "missing": {"type": "object"},
        "missing_piece_count": {"type": "integer"},
        "missing_sku_count": {"type": "integer"},
        "within_shop_budget": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
