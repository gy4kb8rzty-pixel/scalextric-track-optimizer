{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scalextric user inventory",
  "type": "object",
  "required": ["parts"],
  "properties": {
    "user_id": {"type": "string"},
    "display_name": {"type": "string"},
    "parts": {
      "type": "object",
      "description": "Base part id to quantity. Example: C8205, C8235, C8204, C156.",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "detailing": {
      "type": "object",
      "properties": {
        "theme": {"type": "string"},
        "borders": {"type": "boolean"},
        "barriers": {"type": "boolean"},
        "elevation": {"type": "boolean"}
      }
    }
  }
}
